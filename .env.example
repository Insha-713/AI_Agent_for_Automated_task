# ==========================================
# AgentFlow Configuration (Local & Cloud AI)
# ==========================================

# Active LLM Provider: 'ollama' (default local), 'groq' (cloud), or 'gemini' (cloud)
# Leave empty or set to 'ollama' for 100% free local inference.
# On cloud deployments (e.g. Render), set LLM_PROVIDER=groq or LLM_PROVIDER=gemini.
LLM_PROVIDER=ollama

# Optional Model Override
# Groq defaults to 'llama-3.3-70b-versatile'
# Gemini defaults to 'gemini-1.5-flash'
# Ollama defaults to 'llama3.1'
LLM_MODEL=

# Cloud Provider API Keys (Never commit real keys to git)
# Groq: Free high-speed inference from https://console.groq.com
GROQ_API_KEY=

# Google Gemini: Free API from https://aistudio.google.com
GEMINI_API_KEY=

# Ollama LLM Settings (For local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Workspace directory for sandboxed file operations
WORKSPACE_DIR=workspace

# Gmail SMTP Settings (Optional - for send_email tool)
# Generate App Password in Google Account -> Security -> App passwords
EMAIL_USER=
EMAIL_PASS=

# Telegram Bot Settings (Optional - for Telegram delivery & daily digests)
# Create a bot via @BotFather on Telegram and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Settings
PORT=8000
HOST=127.0.0.1
