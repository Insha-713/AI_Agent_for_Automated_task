# ==========================================
# AgentFlow Configuration (Local & Cloud AI)
# ==========================================

# Active LLM Provider: 'ollama' (default local), 'groq' (cloud), or 'gemini' (cloud)
# Leave empty or set to 'ollama' for 100% free local inference.
# On cloud deployments (e.g. Render), set LLM_PROVIDER=groq or LLM_PROVIDER=gemini.
LLM_PROVIDER=ollama

# Optional Model Override
# Groq defaults to 'llama-3.3-70b-versatile'
# Gemini defaults to 'gemini-1.5-flash'
# Ollama defaults to 'llama3.1'
LLM_MODEL=

# Cloud Provider API Keys (Never commit real keys to git)
# Groq: Free high-speed inference from https://console.groq.com
GROQ_API_KEY=

# Google Gemini: Free API from https://aistudio.google.com
GEMINI_API_KEY=

# Ollama LLM Settings (For local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Workspace directory for sandboxed file operations
WORKSPACE_DIR=workspace

# ==========================================
# Email Provider Configuration (Local & Cloud)
# ==========================================

# Active Email Provider: 'smtp' (default local), 'brevo' (cloud/Render HTTPS API), or 'resend' (cloud/Render HTTPS API)
# Render free tier blocks outbound SMTP ports 25, 465, and 587.
# For Render deployments, use Brevo or Resend (outbound HTTPS port 443).
EMAIL_PROVIDER=smtp

# Brevo (formerly Sendinblue) HTTPS API (Port 443 - Recommended for Render)
# Free account at https://app.brevo.com -> SMTP & API -> Generate API Key
BREVO_API_KEY=
EMAIL_FROM=

# Resend HTTPS API (Port 443 - Alternative for Render)
# Free account at https://resend.com -> API Keys
# Note: Unverified accounts can only send from onboarding@resend.dev to registered email
RESEND_API_KEY=

# Gmail SMTP Settings (For local machine execution only)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# Telegram Bot Settings (Optional - for Telegram delivery & daily digests)
# Create a bot via @BotFather on Telegram and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# Database Configuration (Persistent Storage)
# ==========================================

# PostgreSQL Connection URL (Recommended for cloud deployments on Render / Neon / Supabase)
# Example: postgresql://username:password@ep-host.region.neon.tech/neondb?sslmode=require
# When empty, AgentFlow automatically defaults to local SQLite (backend/agentflow.db).
DATABASE_URL=

# CORS Allowed Origins (Comma-separated origins for web security)
# Example: https://ai-agent-for-automated-task.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Server Settings
PORT=8000
HOST=127.0.0.1
